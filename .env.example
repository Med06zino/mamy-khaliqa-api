# Option 3 : Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Option 4 : Email administrateur
ADMIN_NOTIFICATION_EMAIL=admin@mamy-khaliqa.com
