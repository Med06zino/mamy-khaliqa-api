# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (si vide, SQLite est utilise en developpement uniquement)
DATABASE_URL=postgres://mamy:mamy@localhost:5432/mamy_khaliqa
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# URL publique du frontend (liens de reinitialisation du mot de passe)
FRONTEND_URL=http://localhost:5173
# E-mail (console en developpement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mamy Khaliqa <no-reply@example.com>
# Numero WhatsApp par defaut (format international sans +). Modifiable dans l'administration.
WHATSAPP_NUMBER=
