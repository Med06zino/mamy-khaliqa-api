# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Base de données PostgreSQL (obligatoire en local et en production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mamy_khaliqa
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# URL publique du frontend (liens de reinitialisation du mot de passe)
FRONTEND_URL=http://localhost:5173
# E-mail (console en developpement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mamy Khaliqa <no-reply@example.com>
# Numero WhatsApp par defaut (format international sans +). Modifiable dans l'administration.
WHATSAPP_NUMBER=221770000000

# ==========================================
# WAVE SENEGAL BUSINESS (API Checkout)
# ==========================================
# Obtenu sur le dashboard Wave Business (https://business.wave.com)
WAVE_API_KEY=wave_sn_prod_xxxxxxxxxxxxxx
WAVE_WEBHOOK_SECRET=wave_whsec_xxxxxxxxxxxxxx
WAVE_SIMULATION_MODE=True

# ==========================================
# SASPAY - PASSERELLE DE PAIEMENT
# ==========================================
SASPAY_BASE_URL=https://api.saspay.me/api/v1
SASPAY_API_KEY=sk_live_xxxxxxxxxxxxxx
SASPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxx

# ==========================================
# NOTIFICATIONS ADMINISTRATEUR (Paiement Reçu)
# ==========================================
# Option 1 : Bot Telegram (Recommandé, gratuit, instantané)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=123456789

# Option 2 : WhatsApp API UltraMsg
ULTRAMSG_INSTANCE_ID=instance12345
ULTRAMSG_TOKEN=abcdef123456
